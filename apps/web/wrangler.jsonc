{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wpexit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "RESEND_FROM": "WP Exit Scanner <hello@wpexit.dev>",
    "RESEND_REPLY_TO": "flyhawking@gmail.com"
  },
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "4214d5fd503e4269898221ea21243df2"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wpexit",
      "database_id": "b935b572-5b90-4b60-9223-a6aea824da9b"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wpexit"
    }
  ],
  "routes": [
    { "pattern": "wpexit.dev", "custom_domain": true },
    { "pattern": "www.wpexit.dev", "custom_domain": true }
  ]
}
